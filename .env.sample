# ============================================================
# PromptForge-Next 配置模板
# 复制为 .env 后填写
# ============================================================

# ---- 部署模式 ----
DEPLOYMENT=local
HOST=127.0.0.1
PORT=8000
# 手机连 PC 时改成：HOST=0.0.0.0

# ---- 存储 ----
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/assets

# ---- 数据库 ----
DB_BACKEND=sqlite
DB_URL=sqlite:///./data/db/promptforge.sqlite3

# ---- LLM（可选） ----
LLM_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# ---- 图像 / 视频引擎 ----
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-2.5-flash
AGNES_TEXT_MODEL=agnes-2.5-flash
AGNES_VISION_MODEL=agnes-2.5-flash

POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=black-forest-labs/flux.1-schnell

SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=sd-turbo

OPENROUTER_API_KEY=
OPENROUTER_MODEL=bytedance-seed/seedream-4.5

FREEAPI_MODEL=qwen3.7-plus
FREE_MULTIMODAL_PROXY_URL=http://localhost:8080/v1
FREE_MULTIMODAL_PROXY_MODEL=zimage
FREELLMAPI_URL=http://localhost:3000/v1
FREELLMAPI_MODEL=auto

# ---- 兼容旧命名（迁移期保留） ----
VIDEO_DURATION=10
VIDEO_SEGMENT_DURATION=10
VIDEO_AUTO_MERGE=false

# ---- 安全 ----
SAFE_MODE=true
ENABLE_SAFETY_CHECK=true
